<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">



        <!-- Clients -->
        <record id="partner_client_be" model="res.partner">
            <field name="name">Gestionnaire aéroportuaire Belgique</field>
            <field name="company_type">company</field>
            <field name="country_id" ref="base.be"/>
        </record>
        <record id="partner_client_fr" model="res.partner">
            <field name="name">Gestionnaire aéroportuaire France</field>
            <field name="company_type">company</field>
            <field name="country_id" ref="base.fr"/>
        </record>
        <record id="partner_client_nl" model="res.partner">
            <field name="name">Gestionnaire aéroportuaire Pays-Bas</field>
            <field name="company_type">company</field>
            <field name="country_id" ref="base.nl"/>
        </record>

        <!-- Sites -->
        <record id="site_ebbr" model="jdc.site">
            <field name="name">Bruxelles</field>
            <field name="code">EBBR</field>
            <field name="categorie_max">cat3</field>
            <field name="country_id" ref="base.be"/>
            <field name="partner_id" ref="partner_client_be"/>
            <field name="contact">Coordination travaux piste</field>
            <field name="acces_particulier">Badge aéroportuaire obligatoire, escorte côté piste. Interventions hors trafic, créneau de nuit.</field>
        </record>

        <record id="site_eblg" model="jdc.site">
            <field name="name">Liège</field>
            <field name="code">EBLG</field>
            <field name="categorie_max">cat2</field>
            <field name="country_id" ref="base.be"/>
            <field name="partner_id" ref="partner_client_be"/>
            <field name="acces_particulier">Plateforme cargo active 24h/24, créneaux à confirmer la veille.</field>
        </record>

        <record id="site_ebaw" model="jdc.site">
            <field name="name">Anvers</field>
            <field name="code">EBAW</field>
            <field name="categorie_max">cat1</field>
            <field name="country_id" ref="base.be"/>
            <field name="partner_id" ref="partner_client_be"/>
        </record>

        <record id="site_lfpg" model="jdc.site">
            <field name="name">Paris</field>
            <field name="code">LFPG</field>
            <field name="categorie_max">cat3</field>
            <field name="country_id" ref="base.fr"/>
            <field name="partner_id" ref="partner_client_fr"/>
            <field name="acces_particulier">Site suivi depuis l'antenne française. Déplacement mensuel.</field>
        </record>

        <record id="site_lfbd" model="jdc.site">
            <field name="name">Bordeaux</field>
            <field name="code">LFBD</field>
            <field name="categorie_max">cat1</field>
            <field name="country_id" ref="base.fr"/>
            <field name="partner_id" ref="partner_client_fr"/>
        </record>

        <record id="site_eham" model="jdc.site">
            <field name="name">Amsterdam</field>
            <field name="code">EHAM</field>
            <field name="country_id" ref="base.nl"/>
            <field name="partner_id" ref="partner_client_nl"/>
        </record>

        <!-- Contrats -->
        <record id="contrat_ebbr" model="jdc.contrat">
            <field name="site_id" ref="site_ebbr"/>
            <field name="periodicite">trimestrielle</field>
            <field name="etat">actif</field>
            <field name="date_debut" eval="(DateTime.today() + relativedelta(months=-14)).strftime('%Y-%m-%d')"/>
            <field name="date_fin" eval="(DateTime.today() + relativedelta(months=22)).strftime('%Y-%m-%d')"/>
            <field name="date_prochaine" eval="(DateTime.today() + relativedelta(days=-9)).strftime('%Y-%m-%d')"/>
            <field name="notes">Maintenance préventive du balisage de piste et de voie de circulation.</field>
        </record>

        <record id="contrat_eblg" model="jdc.contrat">
            <field name="site_id" ref="site_eblg"/>
            <field name="periodicite">semestrielle</field>
            <field name="etat">actif</field>
            <field name="date_debut" eval="(DateTime.today() + relativedelta(months=-20)).strftime('%Y-%m-%d')"/>
            <field name="date_prochaine" eval="(DateTime.today() + relativedelta(days=18)).strftime('%Y-%m-%d')"/>
        </record>

        <record id="contrat_ebaw" model="jdc.contrat">
            <field name="site_id" ref="site_ebaw"/>
            <field name="periodicite">annuelle</field>
            <field name="etat">actif</field>
            <field name="date_debut" eval="(DateTime.today() + relativedelta(months=-8)).strftime('%Y-%m-%d')"/>
            <field name="date_prochaine" eval="(DateTime.today() + relativedelta(months=4)).strftime('%Y-%m-%d')"/>
        </record>

        <record id="contrat_lfpg" model="jdc.contrat">
            <field name="site_id" ref="site_lfpg"/>
            <field name="periodicite">trimestrielle</field>
            <field name="etat">actif</field>
            <field name="date_debut" eval="(DateTime.today() + relativedelta(months=-11)).strftime('%Y-%m-%d')"/>
            <field name="date_prochaine" eval="(DateTime.today() + relativedelta(days=5)).strftime('%Y-%m-%d')"/>
            <field name="notes">Déplacement groupé avec les autres sites français.</field>
        </record>

        <record id="contrat_lfbd" model="jdc.contrat">
            <field name="site_id" ref="site_lfbd"/>
            <field name="periodicite">semestrielle</field>
            <field name="etat">brouillon</field>
            <field name="date_debut" eval="(DateTime.today() + relativedelta(days=-3)).strftime('%Y-%m-%d')"/>
            <field name="date_prochaine" eval="(DateTime.today() + relativedelta(months=6)).strftime('%Y-%m-%d')"/>
        </record>
    </data>
</odoo>
