<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_jdc_intervention_tree" model="ir.ui.view">
        <field name="name">jdc.intervention.tree</field>
        <field name="model">jdc.intervention</field>
        <field name="arch" type="xml">
            <tree string="Interventions"
                  decoration-danger="type_intervention == 'corrective' and etat != 'termine'"
                  decoration-warning="etat == 'termine' and not bon_confirme"
                  decoration-muted="etat == 'annule'">
                <field name="name"/>
                <field name="date_intervention"/>
                <field name="site_id"/>
                <field name="contrat_id" optional="show"/>
                <field name="type_intervention"/>
                <field name="nature" optional="show"/>
                <field name="technicien_id"/>
                <field name="equipe_id" optional="show"/>
                <field name="duree" sum="Total heures"/>
                <field name="travail_de_nuit" optional="hide"/>
                <field name="bon_confirme" optional="show"/>
                <field name="etat"/>
            </tree>
        </field>
    </record>

    <record id="view_jdc_intervention_form" model="ir.ui.view">
        <field name="name">jdc.intervention.form</field>
        <field name="model">jdc.intervention</field>
        <field name="arch" type="xml">
            <form string="Intervention">
                <header>
                    <button name="action_demarrer" type="object" string="Démarrer"
                            class="btn-primary" invisible="etat != 'planifie'"/>
                    <button name="action_terminer" type="object" string="Terminer"
                            class="btn-primary" invisible="etat != 'en_cours'"/>
                    <button name="action_imprimer_bon" type="object"
                            string="Imprimer le bon" class="btn-secondary"
                            invisible="etat == 'annule'"/>
                    <button name="action_confirmer_bon" type="object"
                            string="Confirmer le bon signé" class="btn-primary"
                            invisible="bon_confirme or etat == 'annule'"/>
                    <button name="action_annuler" type="object" string="Annuler"
                            invisible="etat in ('termine', 'annule')"/>
                    <button name="action_remettre_brouillon" type="object" string="Replanifier"
                            invisible="etat != 'annule'"/>
                    <field name="etat" widget="statusbar"
                           statusbar_visible="planifie,en_cours,termine"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_imprimer_bon" type="object"
                                class="oe_stat_button" icon="fa-print"
                                invisible="etat == 'annule'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Bon PDF</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Bon confirmé" bg_color="text-bg-success"
                            invisible="not bon_confirme"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="contrat_id"/>
                            <field name="partner_id"/>
                            <field name="date_intervention"/>
                        </group>
                        <group>
                            <field name="type_intervention" widget="radio"/>
                            <field name="nature"/>
                            <field name="technicien_id" widget="many2one_avatar_user"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   placeholder="Assigner un technicien de votre équipe..."/>
                            <field name="equipe_id" readonly="1"/>
                            <field name="duree"/>
                            <field name="travail_de_nuit"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="technicien_id">
                        Mission non assignée. Un responsable doit choisir un technicien
                        de son équipe avant que la mission apparaisse dans « Mes interventions ».
                    </div>
                    <group>
                        <group string="Circuits concernés">
                            <field name="circuit_ids" nolabel="1" widget="many2many_tags"/>
                        </group>
                        <group string="Sécurité électrique">
                            <field name="habilitation" placeholder="B2V, BR..."/>
                            <field name="consignation"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rapport" name="rapport">
                            <group>
                                <field name="description" nolabel="1"
                                       placeholder="Travaux réalisés sur site..."/>
                            </group>
                            <group string="Constat et anomalies">
                                <field name="constat" nolabel="1"
                                       placeholder="Anomalies relevées, mesures, points de vigilance..."/>
                            </group>
                            <group string="Suite à donner">
                                <field name="suite_a_donner" nolabel="1"
                                       placeholder="Pièces à commander, retour prévu, escalade..."/>
                            </group>
                            <group>
                                <field name="signataire"/>
                            </group>
                        </page>
                        <page string="Relevés" name="releves">
                            <field name="mesure_ids">
                                <tree editable="bottom">
                                    <field name="circuit_id"/>
                                    <field name="date"/>
                                    <field name="type_controle"/>
                                    <field name="intensite_mesuree"/>
                                    <field name="isolement_mohm"/>
                                    <field name="nb_feux_hs"/>
                                    <field name="conforme" widget="boolean_toggle"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Bon d'intervention" name="bon">
                            <div class="alert alert-info" role="alert">
                                <ol class="mb-0">
                                    <li>Imprimez le bon d'intervention (bouton en haut ou Imprimer).</li>
                                    <li>Faites-le signer sur place par le représentant du client.</li>
                                    <li>Photographiez ou scannez le document signé, puis joignez-le ci-dessous pour confirmer.</li>
                                </ol>
                            </div>
                            <group>
                                <group string="Visa">
                                    <field name="signataire"/>
                                    <field name="bon_confirme"/>
                                    <field name="date_bon_confirme"/>
                                </group>
                                <group string="Photo du bon signé">
                                    <field name="bon_signe" widget="image"
                                           filename="bon_signe_filename"
                                           options="{'size': [0, 240]}"
                                           class="oe_avatar"/>
                                    <field name="bon_signe_filename" invisible="1"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Le PDF reprend l'en-tête de la société Odoo (logo et adresse).
                                La confirmation ne repose pas sur une case cochée : elle vient de la photo jointe.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_jdc_intervention_kanban" model="ir.ui.view">
        <field name="name">jdc.intervention.kanban</field>
        <field name="model">jdc.intervention</field>
        <field name="arch" type="xml">
            <kanban default_group_by="etat" class="o_kanban_small_column">
                <field name="name"/>
                <field name="site_id"/>
                <field name="type_intervention"/>
                <field name="date_intervention"/>
                <field name="technicien_id"/>
                <field name="duree"/>
                <field name="etat"/>
                <field name="bon_confirme"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="site_id"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="name"/>
                                    </small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <span t-if="record.type_intervention.raw_value == 'corrective'"
                                      class="badge text-bg-danger">Corrective</span>
                                <span t-if="record.type_intervention.raw_value == 'preventive'"
                                      class="badge text-bg-success">Préventive</span>
                                <span class="ms-2"><field name="date_intervention"/></span>
                                <div class="mt-1" t-if="record.bon_confirme.raw_value">
                                    <span class="badge text-bg-success">Bon signé</span>
                                </div>
                                <div class="mt-1"
                                     t-elif="record.etat.raw_value == 'termine' and !record.bon_confirme.raw_value">
                                    <span class="badge text-bg-warning">Bon à confirmer</span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span><field name="duree"/> h</span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="technicien_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_jdc_intervention_search" model="ir.ui.view">
        <field name="name">jdc.intervention.search</field>
        <field name="model">jdc.intervention</field>
        <field name="arch" type="xml">
            <search string="Interventions">
                <field name="name"/>
                <field name="site_id"/>
                <field name="technicien_id"/>
                <field name="contrat_id"/>
                <filter name="f_preventive" string="Préventives"
                        domain="[('type_intervention','=','preventive')]"/>
                <filter name="f_corrective" string="Correctives"
                        domain="[('type_intervention','=','corrective')]"/>
                <separator/>
                <filter name="f_ouvertes" string="Non terminées"
                        domain="[('etat','not in',('termine','annule'))]"/>
                <filter name="f_non_assignees" string="Non assignées"
                        domain="[('technicien_id','=',False)]"/>
                <filter name="f_nuit" string="De nuit" domain="[('travail_de_nuit','=',True)]"/>
                <separator/>
                <filter name="f_bon_confirme" string="Bons confirmés"
                        domain="[('bon_confirme','=',True)]"/>
                <filter name="f_bon_a_confirmer" string="Bons à confirmer"
                        domain="[('bon_confirme','=',False), ('etat','=','termine')]"/>
                <separator/>
                <filter name="f_mois" string="Ce mois-ci" date="date_intervention"/>
                <group expand="0" string="Regrouper par">
                    <filter name="g_site" string="Site" context="{'group_by':'site_id'}"/>
                    <filter name="g_type" string="Type" context="{'group_by':'type_intervention'}"/>
                    <filter name="g_tech" string="Technicien" context="{'group_by':'technicien_id'}"/>
                    <filter name="g_equipe" string="Équipe" context="{'group_by':'equipe_id'}"/>
                    <filter name="g_etat" string="État" context="{'group_by':'etat'}"/>
                    <filter name="g_date" string="Mois" context="{'group_by':'date_intervention:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_jdc_intervention_pivot" model="ir.ui.view">
        <field name="name">jdc.intervention.pivot</field>
        <field name="model">jdc.intervention</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des interventions">
                <field name="site_id" type="row"/>
                <field name="type_intervention" type="col"/>
                <field name="duree" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_jdc_intervention_graph" model="ir.ui.view">
        <field name="name">jdc.intervention.graph</field>
        <field name="model">jdc.intervention</field>
        <field name="arch" type="xml">
            <graph string="Heures par site" type="bar">
                <field name="site_id"/>
                <field name="duree" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_jdc_intervention_calendar" model="ir.ui.view">
        <field name="name">jdc.intervention.calendar</field>
        <field name="model">jdc.intervention</field>
        <field name="arch" type="xml">
            <calendar string="Planning" date_start="date_intervention"
                      color="site_id" mode="month">
                <field name="site_id"/>
                <field name="type_intervention"/>
            </calendar>
        </field>
    </record>

    <record id="action_jdc_intervention" model="ir.actions.act_window">
        <field name="name">Interventions</field>
        <field name="res_model">jdc.intervention</field>
        <field name="view_mode">kanban,tree,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="view_jdc_intervention_search"/>
    </record>

    <record id="action_jdc_intervention_analyse" model="ir.actions.act_window">
        <field name="name">Analyse</field>
        <field name="res_model">jdc.intervention</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="view_jdc_intervention_search"/>
    </record>


    <record id="action_jdc_intervention_mes" model="ir.actions.act_window">
        <field name="name">Mes interventions</field>
        <field name="res_model">jdc.intervention</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
        <field name="search_view_id" ref="view_jdc_intervention_search"/>
        <field name="domain">[('technicien_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune mission assignée pour le moment
            </p>
            <p>
                Vous ne créez pas d'intervention. Dès qu'un responsable vous en assigne
                une, elle apparaît ici. Complétez-la, imprimez le bon, joignez la photo
                signée, puis attendez la suivante.
            </p>
        </field>
    </record>

    <record id="action_jdc_intervention_a_assigner" model="ir.actions.act_window">
        <field name="name">À assigner</field>
        <field name="res_model">jdc.intervention</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_jdc_intervention_search"/>
        <field name="domain">[('technicien_id', '=', False), ('etat', 'not in', ('termine', 'annule'))]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune mission en attente d'assignation
            </p>
            <p>
                Assignez un technicien de votre équipe pour que la mission
                apparaisse dans « Mes interventions ».
            </p>
        </field>
    </record>

    <record id="action_jdc_intervention_bons_a_confirmer" model="ir.actions.act_window">
        <field name="name">Bons à confirmer</field>
        <field name="res_model">jdc.intervention</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_jdc_intervention_search"/>
        <field name="domain">[('etat', '=', 'termine'), ('bon_confirme', '=', False)]</field>
        <field name="context">{'search_default_f_bon_a_confirmer': 1}</field>
    </record>

</odoo>
