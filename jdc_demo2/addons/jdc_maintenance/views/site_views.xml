<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_jdc_site_tree" model="ir.ui.view">
        <field name="name">jdc.site.tree</field>
        <field name="model">jdc.site</field>
        <field name="arch" type="xml">
            <tree string="Sites"
                  decoration-danger="etat_site == 'critique'"
                  decoration-warning="etat_site == 'vigilance'"
                  decoration-success="etat_site == 'ok'">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="partner_id"/>
                <field name="categorie_max" optional="show"/>
                <field name="etat_site" widget="badge"
                       decoration-success="etat_site == 'ok'"
                       decoration-warning="etat_site == 'vigilance'"
                       decoration-danger="etat_site == 'critique'"/>
                <field name="nb_feux_total"/>
                <field name="feux_hs_total"/>
                <field name="taux_disponibilite"/>
                <field name="nb_circuits_non_conformes"/>
                <field name="circuit_count"/>
                <field name="contrat_count"/>
                <field name="intervention_count"/>
                <field name="heures_total" sum="Total heures"/>
            </tree>
        </field>
    </record>

    <record id="view_jdc_site_form" model="ir.ui.view">
        <field name="name">jdc.site.form</field>
        <field name="model">jdc.site</field>
        <field name="arch" type="xml">
            <form string="Site">
                <header>
                    <button name="action_saisie_campagne" type="object"
                            string="Saisie rapide de campagne" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_voir_interventions" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="intervention_count" widget="statinfo" string="Interventions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Aéroport de..."/></h1>
                        <h2>
                            <field name="etat_site" widget="badge"
                                   decoration-success="etat_site == 'ok'"
                                   decoration-warning="etat_site == 'vigilance'"
                                   decoration-danger="etat_site == 'critique'"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="country_id"/>
                            <field name="partner_id"/>
                            <field name="categorie_max"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="contact"/>
                            <field name="telephone"/>
                            <field name="nb_feux_total"/>
                            <field name="feux_hs_total"/>
                            <field name="taux_disponibilite"/>
                            <field name="nb_circuits_non_conformes"/>
                            <field name="circuit_count"/>
                            <field name="heures_total"/>
                        </group>
                    </group>
                    <group string="Accès et contraintes">
                        <field name="acces_particulier" nolabel="1"
                               placeholder="Badge, escorte, créneaux autorisés, travaux de nuit..."/>
                    </group>
                    <notebook>
                        <page string="Circuits" name="circuits">
                            <field name="circuit_ids" readonly="1">
                                <tree decoration-danger="conformite == 'non_conforme'"
                                      decoration-warning="conformite == 'surveillance'">
                                    <field name="name"/>
                                    <field name="designation"/>
                                    <field name="systeme"/>
                                    <field name="categorie"/>
                                    <field name="nb_feux"/>
                                    <field name="nb_feux_hs"/>
                                    <field name="taux_disponibilite"/>
                                    <field name="conformite"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Contrats" name="contrats">
                            <field name="contrat_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="periodicite"/>
                                    <field name="date_prochaine"/>
                                    <field name="etat"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_jdc_site_search" model="ir.ui.view">
        <field name="name">jdc.site.search</field>
        <field name="model">jdc.site</field>
        <field name="arch" type="xml">
            <search string="Sites">
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="country_id"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_etat" string="État" context="{'group_by':'etat_site'}"/>
                    <filter name="group_pays" string="Pays" context="{'group_by':'country_id'}"/>
                    <filter name="group_client" string="Client" context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_jdc_site_kanban" model="ir.ui.view">
        <field name="name">jdc.site.kanban</field>
        <field name="model">jdc.site</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="categorie_max"/>
                <field name="taux_disponibilite"/>
                <field name="etat_site"/>
                <field name="feux_hs_total"/>
                <field name="nb_feux_total"/>
                <field name="nb_circuits_non_conformes"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="code"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="text-muted mb-2">
                                    <field name="categorie_max"/>
                                </div>
                                <div class="text-center mb-2">
                                    <span t-if="record.etat_site.raw_value == 'ok'"
                                          class="badge text-bg-success fs-2">
                                        <field name="taux_disponibilite"/> %
                                    </span>
                                    <span t-elif="record.etat_site.raw_value == 'vigilance'"
                                          class="badge text-bg-warning fs-2">
                                        <field name="taux_disponibilite"/> %
                                    </span>
                                    <span t-else="" class="badge text-bg-danger fs-2">
                                        <field name="taux_disponibilite"/> %
                                    </span>
                                </div>
                                <div>
                                    <field name="feux_hs_total"/> hors service
                                    / <field name="nb_feux_total"/> feux
                                </div>
                                <div class="mt-2" t-if="record.nb_circuits_non_conformes.raw_value == 1">
                                    <span class="badge text-bg-danger">1 circuit non conforme</span>
                                </div>
                                <div class="mt-2" t-elif="record.nb_circuits_non_conformes.raw_value &gt; 1">
                                    <span class="badge text-bg-danger">
                                        <field name="nb_circuits_non_conformes"/> circuits non conformes
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_jdc_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">jdc.site</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_jdc_site_search"/>
    </record>

    <record id="action_jdc_vue_ensemble" model="ir.actions.act_window">
        <field name="name">Vue d'ensemble</field>
        <field name="res_model">jdc.site</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_jdc_site_search"/>
    </record>

</odoo>
