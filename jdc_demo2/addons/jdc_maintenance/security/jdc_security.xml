<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_jdc" model="ir.module.category">
            <field name="name">Maintenance</field>
            <field name="description">Droits sur le suivi de la maintenance multi-sites.</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_jdc_technicien" model="res.groups">
            <field name="name">Technicien</field>
            <field name="category_id" ref="module_category_jdc"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Voit uniquement ses missions assignées, les complète, imprime et confirme le bon. Ne crée pas d'intervention.</field>
        </record>

        <record id="group_jdc_manager" model="res.groups">
            <field name="name">Responsable</field>
            <field name="category_id" ref="module_category_jdc"/>
            <field name="implied_ids" eval="[(4, ref('group_jdc_technicien'))]"/>
            <field name="comment">Crée et assigne les missions aux techniciens de ses équipes, suit les messages et les bons.</field>
        </record>

        <record id="group_jdc_admin" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="category_id" ref="module_category_jdc"/>
            <field name="implied_ids" eval="[(4, ref('group_jdc_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Configure les équipes (quel responsable gère quels techniciens) et voit tout.</field>
        </record>

        <!-- Technicien : uniquement ses missions, pas de suppression. -->
        <record id="rule_jdc_intervention_technicien" model="ir.rule">
            <field name="name">Interventions : technicien = ses missions</field>
            <field name="model_id" ref="model_jdc_intervention"/>
            <field name="domain_force">[('technicien_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_jdc_technicien'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Responsable : missions de ses techniciens + non assignées + celles qu'il a créées. -->
        <record id="rule_jdc_intervention_manager" model="ir.rule">
            <field name="name">Interventions : responsable = son équipe</field>
            <field name="model_id" ref="model_jdc_intervention"/>
            <field name="domain_force">['|', '|', ('technicien_id', '=', False), ('technicien_id', 'in', user.jdc_technicien_gere_ids.ids), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_jdc_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Administrateur maintenance : tout. -->
        <record id="rule_jdc_intervention_admin" model="ir.rule">
            <field name="name">Interventions : administrateur = toutes</field>
            <field name="model_id" ref="model_jdc_intervention"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_jdc_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Équipes : lecture responsable, gestion admin. -->
        <record id="rule_jdc_equipe_manager" model="ir.rule">
            <field name="name">Équipes : responsable lit les siennes</field>
            <field name="model_id" ref="model_jdc_equipe"/>
            <field name="domain_force">[('responsable_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_jdc_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_jdc_equipe_admin" model="ir.rule">
            <field name="name">Équipes : administrateur = toutes</field>
            <field name="model_id" ref="model_jdc_equipe"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_jdc_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
